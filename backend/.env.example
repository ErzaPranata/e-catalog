# ============================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# Never commit .env to git!

# Database (Supabase/PostgreSQL)
# DATABASE_URL: Use Supabase Transaction Pooler (port 6543) for application connections
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# DIRECT_URL: Use Supabase Session Pooler (port 5432) or direct connection for Prisma migrations
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres
DIRECT_URL=

# JWT Secrets (generate with: openssl rand -base64 32)
# Use different values for ACCESS and REFRESH
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=production

# Frontend URL (your Vercel frontend domain) - Required for CORS
FRONTEND_URL=

# Supabase (for image storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# Admin Bootstrap (first admin user) - Required for initial setup
ADMIN_BOOTSTRAP_NAME=Super Admin
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Store Defaults
STORE_DEFAULT_NAME=E-Catalog Store
STORE_DEFAULT_WHATSAPP=

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Optional: Enable Swagger in production
# ENABLE_SWAGGER=true

# Optional: Local upload fallback (when Supabase not configured)
# LOCAL_UPLOAD_DIR=./uploads
# LOCAL_PUBLIC_URL=http://localhost:3001/uploads