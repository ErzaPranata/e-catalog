generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  NOT_APPLICABLE
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
}

model Category {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("categories")
}

model Product {
  id            String   @id @default(uuid())
  categoryId    String
  name          String   @db.VarChar(200)
  slug          String   @unique @db.VarChar(220)
  sku           String   @unique @db.VarChar(60)
  description   String?  @db.Text
  basePrice     Decimal  @db.Decimal(12, 2) @default(0)
  stock         Int      @default(0)
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category      Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  variants      ProductVariant[]
  orderItems    OrderItem[]

  @@index([categoryId])
  @@index([isPublished])
  @@index([slug])
  @@index([sku])
  @@map("products")
}

model ProductImage {
  id          String   @id @default(uuid())
  productId   String
  variantId   String?  // Link to variant for variant-specific images
  imageUrl    String   @db.Text
  storagePath String?  @db.Text
  altText     String?  @db.VarChar(200)
  sortOrder   Int      @default(0)
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, isPrimary])
  @@index([productId, sortOrder])
  @@index([variantId])
  @@map("product_images")
}

model ProductVariant {
  id          String   @id @default(uuid())
  productId   String
  name        String   @db.VarChar(100)
  sku         String   @unique @db.VarChar(60)
  price       Decimal  @db.Decimal(12, 2) @default(0)
  stock       Int      @default(0)
  attributes  Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  images      ProductImage[] // Variant-specific images

  @@index([productId])
  @@index([isActive])
  @@index([sku])
  @@map("product_variants")
}

model Order {
  id            String       @id @default(uuid())
  orderNumber   String       @unique @db.VarChar(30)
  customerName  String       @db.VarChar(150)
  phone         String       @db.VarChar(30)
  address       String       @db.Text
  notes         String?      @db.Text
  subtotal      Decimal      @db.Decimal(12, 2)
  total         Decimal      @db.Decimal(12, 2)
  status        OrderStatus  @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  items         OrderItem[]

  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  productId    String?
  variantId    String?
  productName  String   @db.VarChar(200)
  variantName  String?  @db.VarChar(100)
  sku          String   @db.VarChar(60)
  unitPrice    Decimal  @db.Decimal(12, 2)
  quantity     Int
  lineTotal    Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model AdminUser {
  id           String     @id @default(uuid())
  name         String     @db.VarChar(100)
  email        String     @unique @db.VarChar(150)
  passwordHash String     @db.VarChar(255)
  role         AdminRole  @default(ADMIN)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([email])
  @@index([isActive])
  @@map("admin_users")
}

model StoreSetting {
  id              String   @id @default(uuid())
  storeName       String   @db.VarChar(100)
  storeDescription String? @db.Text
  whatsappNumber  String   @db.VarChar(30)
  currency        String   @default("IDR") @db.VarChar(10)
  storeAddress    String?  @db.Text
  announcement    String?  @db.Text
  updatedAt       DateTime @updatedAt

  @@map("store_settings")
}