# Backend Production Environment
# Copy to Vercel Environment Variables dashboard

# Database (REQUIRED: Use managed PostgreSQL - NOT localhost)
# Options: Neon (neon.tech), Railway, Render, Supabase, PlanetScale, etc.
# Format: postgresql://user:password@host:5432/database?schema=public
DATABASE_URL=postgresql://user:password@your-db-host:5432/dbname?schema=public
# For migrations (direct connection, no pooler)
DIRECT_URL=postgresql://user:password@your-db-host:5432/dbname?schema=public&connection_limit=1

# JWT (your current secrets - keep these!)
JWT_ACCESS_SECRET=0e4b81b85e9bd364d573cbb3c29071770382a8b01b2c62466b50dfcb00d7fcc3c2313d27c35686314d920691b2cb74adea4b1eee49ee5c2093537de1e739dd0b
JWT_REFRESH_SECRET=96284b9ad340fca4a8675ebe043cdbdf99969d06e5dcc471ab972a4b6eec657af7cedd78745337d41277b3becc4d639a063de993ebf75c69d0a74eac138777ed
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=production

# Frontend URL (UPDATE: your Vercel frontend domain)
FRONTEND_URL=https://your-frontend.vercel.app

# Image Storage - CHOOSE ONE:
# ============================================
# Option A: Supabase Storage (RECOMMENDED - free tier)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=product-images
#
# Option B: AWS S3 / Cloudflare R2 / MinIO (S3-compatible)
# S3_ENDPOINT=https://s3.amazonaws.com (or your R2 endpoint)
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_BUCKET=product-images
# S3_REGION=us-east-1
# S3_PUBLIC_URL=https://your-bucket.s3.amazonaws.com
#
# Option C: Local fallback (NOT persistent on Vercel!)
# Images saved to /uploads but LOST on redeploy
# LOCAL_UPLOAD_DIR=/tmp/uploads
# LOCAL_PUBLIC_URL=https://your-backend.vercel.app/uploads
# ============================================

# Admin Bootstrap (update for production)
ADMIN_BOOTSTRAP_NAME=Super Admin
ADMIN_BOOTSTRAP_EMAIL=admin@yourdomain.com
ADMIN_BOOTSTRAP_PASSWORD=StrongPassword123!

# Store Defaults
STORE_DEFAULT_NAME=E-Catalog Store
STORE_DEFAULT_WHATSAPP=6281234567890

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100